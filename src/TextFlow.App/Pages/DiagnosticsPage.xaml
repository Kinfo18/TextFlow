<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TextFlow.App.Pages.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer Padding="36,24,36,24">
        <StackPanel Spacing="12" MaxWidth="880" HorizontalAlignment="Left">
            <StackPanel Spacing="2">
                <TextBlock Text="Diagnóstico" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Solo números y nombres de programas: nunca el texto que escribes ni el de tus snippets."
                           Style="{StaticResource BodyTextBlockStyle}" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="DayChoice" AutomationProperties.Name="Día" MinWidth="200" SelectionChanged="OnDayChanged" />
                <Button Click="OnRefresh" AutomationProperties.Name="Actualizar" ToolTipService.ToolTip="Actualizar">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
                <Button Click="OnOpenLogs" AutomationProperties.Name="Abrir carpeta de registros" ToolTipService.ToolTip="Para traer los registros del PC de trabajo">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE838;" FontSize="14" />
                        <TextBlock Text="Abrir carpeta de registros" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Headline numbers -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="ExpansionsValue" Style="{StaticResource TileValue}" />
                        <TextBlock Text="Expansiones" Style="{StaticResource TileLabel}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="SuccessValue" Style="{StaticResource TileValue}" />
                        <TextBlock Text="Insertadas bien" Style="{StaticResource TileLabel}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="LatencyValue" Style="{StaticResource TileValue}" />
                        <TextBlock Text="Tiempo típico" Style="{StaticResource TileLabel}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="MemoryValue" Style="{StaticResource TileValue}" />
                        <TextBlock x:Name="MemoryLabel" Style="{StaticResource TileLabel}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Inserciones" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <StackPanel x:Name="InsertionLines" Spacing="4" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Programas donde más expandes" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <StackPanel x:Name="AppLines" Spacing="4" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Menús y formularios" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <StackPanel x:Name="MenuLines" Spacing="4" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Estabilidad" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <StackPanel x:Name="StabilityLines" Spacing="4" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock x:Name="ReadError" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                       Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</Page>
