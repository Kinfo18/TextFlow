<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TextFlow.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer Padding="36,24,36,24">
        <StackPanel Spacing="4" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Configuración" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,16" />

            <TextBlock Text="Apariencia" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,4" />
            <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <RadioButtons x:Name="ThemeChoice" Header="Tema" SelectionChanged="OnThemeChanged">
                    <x:String>Usar el de Windows</x:String>
                    <x:String>Claro</x:String>
                    <x:String>Oscuro</x:String>
                </RadioButtons>
            </Border>

            <TextBlock Text="Inicio" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
            <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <ToggleSwitch x:Name="StartWithWindowsSwitch" Header="Iniciar TextFlow con Windows (en la bandeja)"
                              OnContent="Activado" OffContent="Desactivado" Toggled="OnStartWithWindowsToggled" />
            </Border>

            <TextBlock Text="Sonido" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
            <Border x:Name="SoundCard" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <ToggleSwitch x:Name="SoundSwitch" Header="Sonar al expandir"
                                  OnContent="Activado" OffContent="Desactivado" Toggled="OnSoundToggled" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="360" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="VolumeSlider" Header="Volumen" Minimum="0" Maximum="100" StepFrequency="5"
                                TickFrequency="25" TickPlacement="Outside" ValueChanged="OnVolumeChanged"
                                KeyUp="OnVolumeKeyUp" />
                        <Button x:Name="TestSoundButton" Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,6"
                                Click="OnTestSound">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="12" />
                                <TextBlock Text="Probar" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock x:Name="SoundStatus" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"
                               Visibility="Collapsed" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Text="Atajo y tiempos" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
            <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="20">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Pausar o reanudar TextFlow" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border x:Name="HotkeyBox" MinWidth="200" Padding="12,6" CornerRadius="6" BorderThickness="1"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}">
                                <TextBlock x:Name="HotkeyText" FontFamily="Consolas" VerticalAlignment="Center" />
                            </Border>
                            <Button x:Name="RecordHotkeyButton" Content="Cambiar" Click="OnRecordHotkey" />
                            <Button x:Name="ResetHotkeyButton" Content="Restablecer" Click="OnResetHotkey" />
                        </StackPanel>
                        <TextBlock x:Name="HotkeyStatus" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.8"
                                   TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <Slider x:Name="PrefixSlider" MaxWidth="360" HorizontalAlignment="Left" Width="360"
                                Minimum="200" Maximum="2000" StepFrequency="100" TickFrequency="300" TickPlacement="Outside"
                                ValueChanged="OnPrefixChanged">
                            <Slider.Header>
                                <TextBlock x:Name="PrefixHeader" />
                            </Slider.Header>
                        </Slider>
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" TextWrapping="Wrap" MaxWidth="560"
                                   HorizontalAlignment="Left"
                                   Text="Cuando una abreviatura es el principio de otra (dir1 y dir12), TextFlow espera este tiempo por si sigues escribiendo antes de expandir la corta." />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="Exclusiones por aplicación" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
            <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="TextFlow no expande abreviaturas ni abre menús en estas aplicaciones." TextWrapping="Wrap" />
                    <StackPanel x:Name="ExclusionList" Spacing="4" />
                    <TextBlock x:Name="NoExclusions" Text="Ninguna todavía." Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="ExclusionInput" Width="220" PlaceholderText="programa.exe" KeyDown="OnExclusionInputKeyDown" />
                        <Button Content="Agregar" Click="OnAddExclusion" />
                        <DropDownButton Content="Apps abiertas">
                            <DropDownButton.Flyout>
                                <MenuFlyout x:Name="RunningAppsFlyout" Placement="Bottom" Opening="OnRunningAppsOpening" />
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </StackPanel>
                    <TextBlock x:Name="ExclusionStatus" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.8"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                    <Expander Header="Exclusiones integradas (siempre activas)" HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Left">
                        <TextBlock x:Name="BuiltinList" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.8" />
                    </Expander>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
