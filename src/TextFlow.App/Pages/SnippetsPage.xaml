<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TextFlow.App.Pages.SnippetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Page.Resources>
        <MenuFlyout x:Key="GroupActions" x:Name="GroupActions">
            <MenuFlyoutItem x:Name="NewGroupItem" Text="Nuevo subgrupo…" Click="OnNewGroup">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8F4;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Name="EditGroupItem" Text="Editar grupo…" Click="OnEditGroup">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem x:Name="DeleteGroupItem" Text="Eliminar grupo…" Click="OnDeleteGroup">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </Page.Resources>

    <Grid Padding="24,16,24,16" ColumnSpacing="12" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <!-- Proportional so the editor never falls off a narrow window (MainWindow enforces a minimum width). -->
            <ColumnDefinition Width="2*" MinWidth="200" />
            <ColumnDefinition Width="2.4*" MinWidth="240" />
            <ColumnDefinition Width="4*" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <!-- Hand-filled XXX blanks can become template fields (H5.2) -->
        <InfoBar x:Name="BlankHint" Grid.ColumnSpan="3" IsOpen="False" Severity="Informational" IsClosable="True"
                 Message="Conviértelos en campos: al expandir, se rellenan solos con lo que copies.">
            <InfoBar.ActionButton>
                <Button Content="Convertir…" Click="OnConvertBlanks" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- Groups -->
        <Grid Grid.Row="1" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Buscar abreviatura, nombre o texto" QueryIcon="Find"
                            TextChanged="OnSearchChanged" />
            <Border Grid.Row="1" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="4">
                <TreeView x:Name="GroupTree" SelectionMode="Single" CanDragItems="True" AllowDrop="True" CanReorderItems="True"
                          ItemInvoked="OnGroupInvoked" DragItemsCompleted="OnGroupDragged" ContextRequested="OnTreeContextRequested" />
            </Border>
        </Grid>

        <!-- Snippets of the group, or search results -->
        <Grid Grid.Row="1" Grid.Column="1" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Padding="4,6,4,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="ListTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ListSubtitle" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.65" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button x:Name="NewSnippetButton" Click="OnNewSnippet" ToolTipService.ToolTip="Nuevo comando en este grupo">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                            <TextBlock Text="Nuevo" />
                        </StackPanel>
                    </Button>
                    <DropDownButton x:Name="GroupButton" Content="Grupo" Flyout="{StaticResource GroupActions}"
                                    ToolTipService.ToolTip="Crear, editar o eliminar el grupo elegido" />
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="4">
                <ListView x:Name="SnippetList" SelectionMode="Single" SelectionChanged="OnSnippetSelected" />
            </Border>
        </Grid>

        <!-- Editor (H3.3) -->
        <Border Grid.Row="1" Grid.Column="2" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel x:Name="EmptyState" Padding="20" Spacing="6">
                    <TextBlock Text="Elige un comando" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Selecciona un grupo a la izquierda o busca por abreviatura, nombre o texto. Con «Nuevo» creas un comando en el grupo elegido."
                               TextWrapping="Wrap" Opacity="0.7" />
                </StackPanel>

                <ScrollViewer x:Name="EditorScroll" Visibility="Collapsed" Padding="20,16,20,8">
                    <StackPanel Spacing="14">
                        <StackPanel>
                            <TextBlock x:Name="DetailTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="DetailPath" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.65" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBox x:Name="AbbreviationsBox" Header="Abreviaturas (una por línea)" AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="60" TextChanged="OnEdited" />
                            <StackPanel x:Name="AbbreviationWarnings" Spacing="4" Visibility="Collapsed" />
                        </StackPanel>
                        <TextBox x:Name="NameBox" Header="Nombre en el menú" PlaceholderText="Si lo dejas vacío, se usa la primera abreviatura"
                                 TextChanged="OnEdited" />
                        <TextBox x:Name="ContentBox" Header="Texto que se inserta" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="180" MaxHeight="420" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 PlaceholderText="Vacío = nota informativa que solo se ve en el menú" TextChanged="OnEdited" />
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,-6,0,0">
                            <DropDownButton ToolTipService.ToolTip="Añade en la posición del cursor un dato que se rellena al expandir">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                                    <TextBlock Text="Insertar" />
                                </StackPanel>
                                <DropDownButton.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                        <MenuFlyoutItem Text="Campo para rellenar…" Click="OnInsertField" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Fecha de hoy" Tag="{}{{date}}" Click="OnInsertToken" />
                                        <MenuFlyoutItem Text="Hora actual" Tag="{}{{time}}" Click="OnInsertToken" />
                                        <MenuFlyoutItem Text="Dónde queda el cursor al expandir" Tag="{}{{cursor}}" Click="OnInsertToken" />
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <TextBlock Text="Un campo como {{cliente}} se rellena copiando el dato al expandir."
                                       Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.65" VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <RadioButtons x:Name="ModeChoice" Header="Se expande" MaxColumns="2" SelectionChanged="OnModeChanged">
                            <x:String>Al escribir la abreviatura</x:String>
                            <x:String>Tras un espacio o signo</x:String>
                        </RadioButtons>
                        <ToggleSwitch x:Name="EnabledSwitch" Header="Activo" OnContent="Se expande" OffContent="Desactivado (sigue en el menú)"
                                      Toggled="OnEnabledToggled" />
                        <CheckBox x:Name="SendEnterBox" Content="Enviar con Enter al expandir (chats: WhatsApp, chat del trabajo)"
                                  Checked="OnSendEnterChanged" Unchecked="OnSendEnterChanged"
                                  ToolTipService.ToolTip="Pulsa Enter justo después de insertar el texto. Si el texto tiene {{cursor}}, se ignora y el mensaje se envía completo." />
                        <TextBlock x:Name="DetailFlags" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="EditorActions" Grid.Row="1" Visibility="Collapsed" Padding="20,10,20,16" ColumnSpacing="8"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SaveButton" Style="{StaticResource AccentButtonStyle}" Click="OnSave" IsEnabled="False">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="S" />
                        </Button.KeyboardAccelerators>
                        Guardar
                    </Button>
                    <Button x:Name="DiscardButton" Grid.Column="1" Click="OnDiscard" IsEnabled="False">Descartar</Button>
                    <TextBlock x:Name="EditorMessage" Grid.Column="2" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" Margin="8,0,8,0" />
                    <Button x:Name="DeleteButton" Grid.Column="3" Click="OnDelete">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74D;" FontSize="12" />
                            <TextBlock Text="Eliminar" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
