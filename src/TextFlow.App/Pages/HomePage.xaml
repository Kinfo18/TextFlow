<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TextFlow.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer Padding="36,24,36,24">
        <StackPanel Spacing="12" MaxWidth="880" HorizontalAlignment="Left">
            <TextBlock Text="Inicio" Style="{StaticResource TitleTextBlockStyle}" />
            <InfoBar x:Name="UpdateBar" IsOpen="False" IsClosable="False" Severity="Success" Title="Actualización lista">
                <InfoBar.ActionButton>
                    <Button Content="Reiniciar y actualizar" Style="{StaticResource AccentButtonStyle}" Click="OnRestartToUpdate" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar x:Name="MessageBar" IsOpen="False" IsClosable="True" Closed="OnMessageClosed" />

            <!-- Engine state: the one thing to know at a glance. -->
            <Border Style="{StaticResource Card}" Padding="20">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="StateBadge" Width="44" Height="44" CornerRadius="22" VerticalAlignment="Center">
                        <FontIcon x:Name="StateIcon" FontSize="20" Foreground="White" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="StateTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="StateDetail" Style="{StaticResource BodyTextBlockStyle}" Opacity="0.75" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch x:Name="ActiveSwitch" Grid.Column="2" VerticalAlignment="Center" MinWidth="0"
                                  OnContent="Activas" OffContent="En pausa" AutomationProperties.Name="Expansiones activas"
                                  Toggled="OnActiveToggled" />
                </Grid>
            </Border>

            <!-- Today in three numbers; the details live in Diagnóstico. -->
            <Grid x:Name="TodayPanel" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="TodayExpansions" Style="{StaticResource TileValue}" />
                        <TextBlock Text="Expansiones hoy" Style="{StaticResource TileLabel}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="TodaySuccess" Style="{StaticResource TileValue}" />
                        <TextBlock Text="Insertadas bien" Style="{StaticResource TileLabel}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="TodayLatency" Style="{StaticResource TileValue}" />
                        <HyperlinkButton Content="Ver diagnóstico" Padding="0" Margin="0,2,0,0" Click="OnShowDiagnostics" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Más usados" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <StackPanel x:Name="TopList" Spacing="6" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Biblioteca" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="LibraryBody" Style="{StaticResource BodyTextBlockStyle}" Opacity="0.75" TextWrapping="Wrap" />
                        <StackPanel x:Name="HomeActions" Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <Button x:Name="ReloadLibraryButton" AutomationProperties.Name="Reimportar desde aText" Click="OnReloadLibrary">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                    <TextBlock Text="Reimportar" />
                                </StackPanel>
                            </Button>
                            <DropDownButton x:Name="MoreLibraryButton" Content="Más" AutomationProperties.Name="Más acciones de biblioteca">
                                <DropDownButton.Flyout>
                                    <MenuFlyout Placement="Bottom">
                                        <MenuFlyoutItem x:Name="ChooseLibraryItem" Text="Importar desde aText…" Click="OnChooseLibrary">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Exportar biblioteca…" Click="OnExportLibrary">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEDE1;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Importar copia de TextFlow…" Click="OnImportLibraryFile">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B5;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Restaurar copia de seguridad…" Click="OnRestoreBackup">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE81C;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
