<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TextFlow.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer Padding="36,24,36,24">
        <StackPanel Spacing="8" MaxWidth="880" HorizontalAlignment="Left">
            <TextBlock Text="Inicio" Style="{StaticResource TitleTextBlockStyle}" />
            <InfoBar x:Name="UpdateBar" IsOpen="False" IsClosable="False" Severity="Success" Title="Actualización lista"
                     Margin="0,4,0,8">
                <InfoBar.ActionButton>
                    <Button Content="Reiniciar y actualizar" Style="{StaticResource AccentButtonStyle}" Click="OnRestartToUpdate" />
                </InfoBar.ActionButton>
            </InfoBar>
            <TextBlock x:Name="SectionBody" Style="{StaticResource BodyTextBlockStyle}" Opacity="0.75" TextWrapping="Wrap" />
            <StackPanel x:Name="HomeActions" Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
                <Button x:Name="ChooseLibraryButton" Style="{StaticResource AccentButtonStyle}" Click="OnChooseLibrary">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                        <TextBlock Text="Importar desde aText…" />
                    </StackPanel>
                </Button>
                <Button x:Name="ReloadLibraryButton" Click="OnReloadLibrary">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="Reimportar" />
                    </StackPanel>
                </Button>
                <DropDownButton x:Name="MoreLibraryButton" Content="Más">
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="Exportar biblioteca…" Click="OnExportLibrary">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEDE1;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Importar copia de TextFlow…" Click="OnImportLibraryFile">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B5;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Restaurar copia de seguridad…" Click="OnRestoreBackup">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE81C;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
