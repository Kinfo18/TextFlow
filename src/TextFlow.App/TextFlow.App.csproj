<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TextFlow.Infrastructure\TextFlow.Infrastructure.csproj" />
    <ProjectReference Include="..\TextFlow.Core\TextFlow.Core.csproj" />
    <ProjectReference Include="..\TextFlow.Contracts\TextFlow.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Velopack" Version="1.2.158" />
  </ItemGroup>

  <ItemGroup>
    <!-- Window, title bar, taskbar and tray icons load these at runtime (the exe icon is embedded via ApplicationIcon). -->
    <Content Include="Assets\*.ico;Assets\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(WindowsTfm)</TargetFramework>
    <TargetPlatformMinVersion>10.0.26100.0</TargetPlatformMinVersion>
    <RootNamespace>TextFlow.App</RootNamespace>
    <AssemblyName>TextFlow</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <!-- ADR-0004: unpackaged, self-contained (no MSIX); ADR-0008: x64 + PerMonitorV2 manifest. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Without MSIX tooling an unpackaged publish leaves out TextFlow.pri and the .xbf files: the tray works but the
         main window fails with XamlParseException (H6, first run on the work PC). -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\TextFlow.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Program.Main runs Velopack before WinUI starts. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- Release builds pass the real one (build/publish-release.ps1). -->
    <Version>0.1.0</Version>
  </PropertyGroup>

</Project>
