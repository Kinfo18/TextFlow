<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\TextFlow.Infrastructure\TextFlow.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\TextFlow.Core\TextFlow.Core.csproj" />
    <ProjectReference Include="..\..\src\TextFlow.Contracts\TextFlow.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Exe (not WinExe): the console shows the PASS/FAIL focus checks of the spike. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>$(WindowsTfm)</TargetFramework>
    <TargetPlatformMinVersion>10.0.26100.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Spike: popup, hook and clipboard live for the whole process; Windows reclaims them on exit. -->
    <NoWarn>$(NoWarn);CA1001</NoWarn>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

</Project>
