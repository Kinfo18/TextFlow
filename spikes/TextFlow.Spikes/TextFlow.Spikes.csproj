<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\TextFlow.Infrastructure\TextFlow.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\TextFlow.Core\TextFlow.Core.csproj" />
    <ProjectReference Include="..\..\src\TextFlow.Contracts\TextFlow.Contracts.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(WindowsTfm)</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- UIAutomationClient: the stress run reads the document through TextPattern -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWPF drops System.IO from the implicit usings (Path would clash with WPF's Shapes.Path). -->
    <Using Include="System.IO" />
  </ItemGroup>

</Project>
